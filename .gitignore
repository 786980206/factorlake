# FactorLake / AlignedTable project

# DuckDB is now a git submodule (pinned v1.5.4, commit 08e34c4), see .gitmodules.
# NOTE: duckdb/build/ is the build output dir inside the submodule (ignored by its own .gitignore).

# Build output
build/
*.o
*.obj

# Test data (generated by scripts/gen_testdata.ps1)
testdata/

# Example data (generated by example_setup.ps1)
example/

# Bench output (generated by scripts/bench_scenarios.sh etc.)
bench/out/
bench_data*
bench_native_*
bench_sort*
bench_min/

# Misc
*.log
*.duckdb
.DS_Store
Thumbs.db

# Python venvs (uv-managed polars runner)
.venv/
.venv-bench/
__pycache__/

# DuckDB temp storage (never commit)
.tmp/
*.tmp

feature_lake/

ddl_test/

bench_test_pc/
bench_test_pcd/
bench_test_pcm/
