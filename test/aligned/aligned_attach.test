# name: test/aligned/aligned_attach.test
# description: aligned_attach / aligned_detach — catalog table registration + standard SQL
# Covers: test_attach.ps1 (5 assertions)
# Requires: gen_testdata.ps1 has been run (cnstk_ixday, 6000 rows)
# Note: aligned_attach registers tables in the session catalog, so attach + DML
# must run in the same duckdb process. Each batch runs SET + attach + query.

# --- attach + count (same batch: SET + attach + count) ---
query I
SET aligned_data_root='{DATA_ROOT}'; SELECT count(*) FROM aligned_table('cnstk_ixday')
----
6000

# --- attach status ---
query T
SET aligned_data_root='{DATA_ROOT}'; SELECT status FROM aligned_attach('cnstk_ixday') WHERE table_name='cnstk_ixday'
----
attached

# --- standard INSERT (attach + insert + count in same batch) ---
query I
SET aligned_data_root='{DATA_ROOT}'; SELECT * FROM (SELECT count(*) FROM aligned_attach('cnstk_ixday')) AS _attach; INSERT INTO cnstk_ixday (date, symbol, close, alpha001, ma5) VALUES (DATE '2026-09-01', '009999', 99.5, 1.5, 2.5); SELECT count(*) FROM cnstk_ixday
----
1
6001

# --- standard UPDATE (attach + insert + update + select) ---
query R
SET aligned_data_root='{DATA_ROOT}'; SELECT * FROM (SELECT count(*) FROM aligned_attach('cnstk_ixday')) AS _attach; INSERT INTO cnstk_ixday (date, symbol, close, alpha001, ma5) VALUES (DATE '2026-09-01', '009999', 99.5, 1.5, 2.5); UPDATE cnstk_ixday SET close = 123.4 WHERE symbol = '009999'; SELECT close FROM cnstk_ixday WHERE symbol = '009999'
----
1
123.4

# --- standard DELETE (attach + insert + delete + count) ---
query I
SET aligned_data_root='{DATA_ROOT}'; SELECT * FROM (SELECT count(*) FROM aligned_attach('cnstk_ixday')) AS _attach; INSERT INTO cnstk_ixday (date, symbol, close) VALUES (DATE '2026-09-01', '009999', 99.5); DELETE FROM cnstk_ixday WHERE symbol = '009999'; SELECT count(*) FROM cnstk_ixday
----
1
6000

# --- detach + aligned storage untouched ---
query T
SET aligned_data_root='{DATA_ROOT}'; SELECT status FROM aligned_detach('cnstk_ixday') WHERE table_name='cnstk_ixday'
----
detached

query I
SET aligned_data_root='{DATA_ROOT}'; SELECT count(*) FROM aligned_table('cnstk_ixday')
----
6000
