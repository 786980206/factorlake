# name: test/aligned/aligned_create_fn.test
# description: aligned_create table function — create table or add column group

# --- create new table (group='index') ---
# table dir + index dir + 1 placeholder partition dir (current month) = 2 dirs, 1 parquet file
query III
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; SELECT * FROM aligned_create('mytable', 'index', 'symbol VARCHAR, date DATE, close DOUBLE')
----
2,1,1

# verify table exists and is empty
query I
ATTACH '{TEST_DIR}/create_fn_data' AS al (TYPE ALIGNED); SELECT count(*) FROM al.mytable
----
0

# COPY data + verify
statement ok
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; COPY (SELECT '000001'::VARCHAR AS symbol, DATE '2026-01-15' AS date, 10.5::DOUBLE AS close) TO 'mytable' (FORMAT aligned, GROUP 'index')

query R
ATTACH '{TEST_DIR}/create_fn_data' AS al (TYPE ALIGNED); SELECT close FROM al.mytable WHERE symbol = '000001'
----
10.5

# --- add a column group to existing table ---
# factor/alpha gets a placeholder for each index partition.
# Index has 2 partitions (month=2026-08 placeholder + month=2026-01 with data)
# = 2 dirs, 2 parquet files
query II
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; SELECT dirs_created, files_created FROM aligned_create('mytable', 'factor/alpha', 'alpha001 DOUBLE, alpha002 DOUBLE')
----
2,2

# verify alpha columns are NULL for existing rows (new group placeholder)
query RR
ATTACH '{TEST_DIR}/create_fn_data' AS al (TYPE ALIGNED); SELECT alpha001, alpha002 FROM al.mytable WHERE symbol = '000001'
----
NULL,NULL

# COPY 000002 into index group first, then factor/alpha group
statement ok
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; COPY (SELECT '000002'::VARCHAR AS symbol, DATE '2026-02-01' AS date, 20.0::DOUBLE AS close) TO 'mytable' (FORMAT aligned, GROUP 'index')

# factor/alpha group (MERGE true to preserve existing rows)
statement ok
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; COPY (SELECT '000002'::VARCHAR AS symbol, DATE '2026-02-01' AS date, 0.3::DOUBLE AS alpha001, 0.5::DOUBLE AS alpha002) TO 'mytable' (FORMAT aligned, GROUP 'factor/alpha', MERGE true)

query RR
ATTACH '{TEST_DIR}/create_fn_data' AS al (TYPE ALIGNED); SELECT alpha001, alpha002 FROM al.mytable WHERE symbol = '000002'
----
0.3,0.5

# --- create with partition_template (date=%Y-%m-%d) ---
query II
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; SELECT dirs_created, files_created FROM aligned_create('ptbl', 'index', 'symbol VARCHAR, date DATE, close DOUBLE', partition_template => 'date=%Y-%m-%d')
----
2,1

# --- error: two VARCHAR columns (new table, PK validation) ---
statement error
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; SELECT * FROM aligned_create('bad_tbl', 'index', 'col1 VARCHAR, col2 VARCHAR')
----
two VARCHAR

# --- error: no data root ---
statement error
SELECT * FROM aligned_create('noroot_tbl', 'index', 'symbol VARCHAR, date DATE')
----
no data root

# --- error: extend non-existent table ---
statement error
SET aligned_data_root = '{TEST_DIR}/create_fn_data'; SELECT * FROM aligned_create('nonexist', 'factor/beta', 'beta001 DOUBLE')
----
does not exist
