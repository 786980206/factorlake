# name: test/aligned/aligned_groups.test
# description: aligned_groups — list column groups in a table

# --- create table with multiple column groups ---
statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT * FROM aligned_create('grp_tbl', 'index', 'symbol VARCHAR, date DATE, close DOUBLE, volume BIGINT')

statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT * FROM aligned_create('grp_tbl', 'factor/alpha', 'alpha001 DOUBLE, alpha002 DOUBLE')

statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT * FROM aligned_create('grp_tbl', 'fieldset/ma', 'ma5 DOUBLE, ma20 DOUBLE')

# --- list groups (columns are semicolon-separated) ---
query TTI rowsort
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT group_name, columns, partition_count FROM aligned_groups('grp_tbl')
----
factor/alpha,alpha001;alpha002,1
fieldset/ma,ma5;ma20,1
index,symbol;date;close;volume,1

# --- verify with explicit root ---
query TTI rowsort
SELECT group_name, columns, partition_count FROM aligned_groups('grp_tbl', root => '{TEST_DIR}/groups_data')
----
factor/alpha,alpha001;alpha002,1
fieldset/ma,ma5;ma20,1
index,symbol;date;close;volume,1

# --- COPY data, then partition_count increases ---
# index group
statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; COPY (SELECT '000001'::VARCHAR AS symbol, DATE '2026-01-15' AS date, 10.5::DOUBLE AS close, 1000::BIGINT AS volume UNION ALL SELECT '000002'::VARCHAR, DATE '2026-02-20', 11.0::DOUBLE, 2000::BIGINT ORDER BY symbol) TO 'grp_tbl' (FORMAT aligned, GROUP 'index')

# factor/alpha group (symbol/date as hidden sort keys, MERGE to preserve alignment)
statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; COPY (SELECT '000001'::VARCHAR AS symbol, DATE '2026-01-15' AS date, 0.3::DOUBLE AS alpha001, 0.5::DOUBLE AS alpha002 UNION ALL SELECT '000002'::VARCHAR, DATE '2026-02-20', 0.4::DOUBLE, 0.6::DOUBLE ORDER BY symbol) TO 'grp_tbl' (FORMAT aligned, GROUP 'factor/alpha', MERGE true)

# fieldset/ma group (symbol/date as hidden sort keys, MERGE to preserve alignment)
statement ok
SET aligned_data_root = '{TEST_DIR}/groups_data'; COPY (SELECT '000001'::VARCHAR AS symbol, DATE '2026-01-15' AS date, 1.0::DOUBLE AS ma5, 2.0::DOUBLE AS ma20 UNION ALL SELECT '000002'::VARCHAR, DATE '2026-02-20', 3.0::DOUBLE, 4.0::DOUBLE ORDER BY symbol) TO 'grp_tbl' (FORMAT aligned, GROUP 'fieldset/ma', MERGE true)

# --- now each group has 3 partitions (2026-08 placeholder + 2026-01 + 2026-02) ---
query TI rowsort
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT group_name, partition_count FROM aligned_groups('grp_tbl')
----
factor/alpha,3
fieldset/ma,3
index,3

# --- error: no data root ---
statement error
SELECT * FROM aligned_groups('noroot_tbl')
----
no data root

# --- error: non-existent table ---
statement error
SET aligned_data_root = '{TEST_DIR}/groups_data'; SELECT * FROM aligned_groups('nonexistent_tbl')
----
does not exist
