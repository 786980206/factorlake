# name: test/aligned/aligned_boundary.test
# description: Boundary conditions — DML empty table, COPY overwrite, scan edge cases, compaction
# Covers edge cases found in Round 1+3 audit

statement ok
LOAD 'aligned'

statement ok
SET threads=4

statement ok
SET preserve_insertion_order=false

# --- DML on empty table: INSERT into a freshly created table ---
statement ok
SET aligned_data_root='{TEST_DIR}'

statement ok
SELECT * FROM aligned_create('bnd_empty', 'index', 'symbol VARCHAR, date DATE, close DOUBLE')

statement ok
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); INSERT INTO al.bnd_empty VALUES ('AAPL', DATE '2026-01-01', 150.0)

query R
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); SELECT close FROM al.bnd_empty WHERE symbol = 'AAPL'
----
150.0

# --- DML: UPDATE on single-row table ---
query R
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); UPDATE al.bnd_empty SET close = 200.0 WHERE symbol = 'AAPL'; SELECT close FROM al.bnd_empty WHERE symbol = 'AAPL'
----
200.0

# --- DML: DELETE all rows (single-row table → partition removed) ---
query I
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); DELETE FROM al.bnd_empty WHERE symbol = 'AAPL'; SELECT count(*) FROM al.bnd_empty
----
0

# --- SCAN: empty result with filter on non-existent value ---
query I
SELECT count(*) FROM aligned_scan('bnd_empty') WHERE symbol = 'ZZZ'
----
0

# --- COPY TO overwrite: writing to same group twice replaces old data ---
statement ok
SELECT * FROM aligned_create('bnd_cpy', 'index', 'symbol VARCHAR, date DATE, val DOUBLE', partition_template => 'year=%Y')

statement ok
COPY (SELECT 'AAA'::VARCHAR AS symbol, DATE '2026-03-01' AS date, 1.0::DOUBLE AS val) TO 'bnd_cpy' (FORMAT aligned, GROUP 'index')

statement ok
COPY (SELECT 'BBB'::VARCHAR AS symbol, DATE '2026-03-02' AS date, 2.0::DOUBLE AS val) TO 'bnd_cpy' (FORMAT aligned, GROUP 'index')

query I
SELECT count(*) FROM aligned_scan('bnd_cpy')
----
1

query RR
SELECT symbol, val FROM aligned_scan('bnd_cpy')
----
BBB,2.0

# --- SCAN: single-column projection (only key col from index) ---
query I
SELECT count(*) FROM aligned_scan('bnd_cpy') WHERE symbol = 'BBB'
----
1

# --- CREATE TABLE DDL: column group extension (table must exist first) ---
statement ok
SELECT * FROM aligned_create('bnd_ddl', 'index', 'symbol VARCHAR, date DATE, v1 DOUBLE', partition_template => 'year=%Y')

statement ok
COPY (SELECT 'X'::VARCHAR AS symbol, DATE '2026-04-01' AS date, 1.5::DOUBLE AS v1) TO 'bnd_ddl' (FORMAT aligned, GROUP 'index')

statement ok
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); CREATE TABLE al.bnd_ddl (ma5 DOUBLE) WITH (groups='fieldset/ma:ma5')

query II
SELECT count(*), count(ma5) FROM aligned_scan('bnd_ddl')
----
1,0

# --- Compaction: single-part table (already normalized, should skip) ---
statement ok
SELECT * FROM aligned_create('bnd_cpt', 'index', 'symbol VARCHAR, date DATE, val DOUBLE', partition_template => 'year=%Y')

statement ok
COPY (SELECT 'S' || printf('%05d', r) AS symbol, DATE '2026-05-01' AS date, CAST(r AS DOUBLE) AS val FROM (SELECT range AS r FROM range(0, 10)) t) TO 'bnd_cpt' (FORMAT aligned, GROUP 'index')

statement ok
SELECT * FROM aligned_compact('bnd_cpt', 'index')

# --- Compaction: multi-part merge (large table with DML) ---
# 2M rows with unique (symbol, date) keys: 2000 symbols × 1000 dates
statement ok
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); CREATE TABLE al.bnd_cpt2 (symbol VARCHAR, date DATE, val DOUBLE) WITH (groups='index:val', partition_template='year=%Y')

statement ok
ATTACH '{TEST_DIR}' AS al (TYPE ALIGNED); INSERT INTO al.bnd_cpt2 SELECT 'S' || printf('%06d', CAST(r / 1000 AS INTEGER)) AS symbol, DATE '2026-01-01' + (r % 1000) * INTERVAL '1 day' AS date, CAST(r AS DOUBLE) AS val FROM (SELECT range AS r FROM range(0, 2000000)) t

statement ok
SELECT * FROM aligned_compact('bnd_cpt2', 'index')

query I
SELECT count(*) FROM aligned_scan('bnd_cpt2')
----
1999001
